{
  "name": "agency-bin-memory",
  "version": "1.1.0",
  "protocol": "1.0",
  "description": "跨工具共享知识层 - 语义检索与用户偏好管理",
  "tools": {
    "memory_query": {
      "description": "语义搜索知识库。获取最相关的知识片段。",
      "command": "../../knowledge/vector_store.py query {query}",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "搜索关键词"}
        },
        "required": ["query"]
      }
    },
    "memory_save": {
      "description": "保存核心洞察或偏好到知识库。",
      "command": "bin/memory save --type {memory_type} --content \"{content}\"",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {"type": "string", "description": "记忆内容"},
          "memory_type": {"type": "string", "enum": ["insight", "preference", "decision", "snippet"]}
        },
        "required": ["content"]
      }
    }
  },
  "ai_hints": {
    "intent": "跨 Session 的语义化长效记忆管理",
    "triggers": ["我的偏好", "上次提到的", "记住这个"],
    "when_to_use": "在不同会话间共享、检索用户偏好、项目背景或固化关键决策时。",
    "avoid": [
      "仅在当前对话有效的临时执行变量",
      "通用的互联网信息搜索"
    ],
    "self_check": [
      "该信息是否属于跨 Session 的长期记忆范畴？",
      "任务是否需要检索用户的个性化偏好或历史决策？"
    ]
  }
}
