#!/usr/bin/env python3
import sys
import os

def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    
    memory_content = " ".join(sys.argv[1:])
    
    # 严格执行 GPT-5 的格式检查
    if "{" in memory_content or "}" in memory_content:
        print("ERROR: Verbatim GPT-5 Protocol Violaton: JSON detected. Only plain text allowed.")
        sys.exit(1)
    
    if not (memory_content.startswith("User") or memory_content.startswith("Forget")):
        print("ERROR: Verbatim GPT-5 Protocol Violaton: Must start with 'User' or 'Forget'.")
        sys.exit(1)

    # 物理存储：利用本项目的底层存储能力，但打上 openai-brain 标签
    # 假设底层 memory_save 已经存在
    os.system(f"python3 skills/agency-bin-memory/bin/memory_save '{memory_content}' --memory_type insight --tags openai-brain")
    print(f"Memory persisted via OpenAI Brain protocol: {memory_content}")

if __name__ == "__main__":
    main()
