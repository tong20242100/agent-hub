#!/usr/bin/env python3
import sys
import os
import re
from pathlib import Path

def get_latest_file(vendor_dir, pattern):
    files = list(vendor_dir.glob("*"))
    # 高级版本解析逻辑：识别文件名中的版本号 (如 4.7, 5) 和日期
    def version_key(f):
        # 寻找文件名中的版本号，如 "Opus 4.7" -> 4.7
        v_match = re.search(r"(\d+\.\d+|\d+)", f.name)
        v = float(v_match.group(1)) if v_match else 0
        # 寻找日期，如 "08-07-2025" -> 20250807
        d_match = re.search(r"(\d{2}-\d{2}-\d{4})", f.name)
        d = d_match.group(1).split("-")[-1] + d_match.group(1).split("-")[0] + d_match.group(1).split("-")[1] if d_match else "0"
        return (v, int(d))

    matches = [f for f in files if re.search(pattern, f.name, re.I)]
    if not matches: return None
    return sorted(matches, key=version_key, reverse=True)[0]

def main():
    raw_dir = Path(__file__).resolve().parent.parent / "data" / "raw"
    
    if len(sys.argv) < 2:
        print("Usage: vault_query recommend <domain> | vault_query read <vendor> <pattern>")
        sys.exit(1)
    
    cmd = sys.argv[1]
    
    if cmd == "recommend":
        # 逻辑：根据领域推荐“最新”文件
        print("Searching for the latest elite standards...")
        # ... (此处省略复杂的 index 匹配逻辑，直接演示核心结果)
        target_vendor = "ANTHROPIC" if "design" in sys.argv[2] else "OPENAI"
        latest = get_latest_file(raw_dir / target_vendor, ".*")
        print(f"### RECOMMENDED LATEST ###")
        print(f"Vendor: {target_vendor}")
        print(f"File: {latest.name}")
        print(f"Status: Top Stability & Modernity")

    elif cmd == "read":
        if len(sys.argv) < 4:
            print("Error: Missing vendor or filename")
            sys.exit(1)
        
        vendor = sys.argv[2]
        filename = sys.argv[3]
        
        file_path = raw_dir / vendor / filename
        if not file_path.exists():
            # 尝试正则匹配文件名
            matches = list((raw_dir / vendor).glob(f"*{filename}*"))
            if matches:
                file_path = matches[0]
            else:
                print(f"Error: File {filename} not found in {vendor}")
                sys.exit(1)
        
        try:
            with open(file_path, "r", encoding="utf-8") as f:
                print(f.read())
        except Exception as e:
            print(f"Error: Failed to read file: {e}")
            sys.exit(1)

if __name__ == "__main__":
    main()
